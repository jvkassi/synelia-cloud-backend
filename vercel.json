{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pip install -r requirements.txt",
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/index.py": { "memory": 1024, "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "env": { "VERCEL": "1", "SYNELIA_ENV": "preview" }
}
